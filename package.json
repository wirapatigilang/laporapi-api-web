{
  "name": "lapor-api",
  "private": true,
  "workspaces": [
    "apps/*",
    "tests/*"
  ],
  "scripts": {
    "dev:api": "cd apps/api && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "db:migrate": "cd apps/api && bun run db:migrate",
    "db:seed": "cd apps/api && bun run db:seed",
    "test:blackbox": "cd tests/blackbox && bun test --timeout 20000",
    "demo:berdekatan": "cd tests/blackbox && bun demo/kejadian-berdekatan.ts"
  }
}
